{
  "name": "@rogerchappel/replaynote",
  "version": "0.1.0",
  "description": "Local-first command replay notes for reproducible developer handoffs.",
  "type": "module",
  "bin": {
    "replaynote": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "examples",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js",
    "smoke": "npm run build && node dist/cli.js run --out /tmp/replaynote-smoke.md --format both -- node --version",
    "validate": "bash scripts/validate.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run release:readiness",
    "release:readiness": "node scripts/validate-release-readiness.mjs"
  },
  "keywords": [
    "cli",
    "markdown",
    "reproducibility",
    "testing",
    "handoff"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/replaynote.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/replaynote/issues"
  },
  "homepage": "https://github.com/rogerchappel/replaynote#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
